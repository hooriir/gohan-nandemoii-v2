// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. ユーザーテーブル
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // リレーション
  memberships HouseholdMember?
  mealRequests MealRequest[]
}

// 2. 世帯テーブル (新規)
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  HouseholdMember[]
  invites  HouseholdInvite[]
  dishes   Dish[]
  showLogs DishShowLog[]
  requests MealRequest[]
  tags     Tag[]
}

// 3. 世帯メンバーテーブル (新規: MVPでは1人1世帯)
model HouseholdMember {
  id          String         @id @default(cuid())
  householdId String
  userId      String         @unique
  role        HouseholdRole  @default(MEMBER)
  joinedAt    DateTime       @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum HouseholdRole {
  OWNER
  MEMBER
}

// 4. 世帯招待コードテーブル (新規)
model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  code        String    @unique
  createdById String
  expiresAt   DateTime
  maxUses     Int       @default(5)
  useCount    Int       @default(0)
  revokedAt   DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// 5. 今日の希望テーブル (新規)
model MealRequest {
  id          String      @id @default(cuid())
  householdId String
  userId      String
  requestDate DateTime    @db.Date
  type        RequestType
  dishId      String?     
  keyword     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish      Dish?     @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@unique([householdId, userId, requestDate])
}

enum RequestType {
  WANT // これ食べたい
  NG   // これはナシ
  ANY  // なんでもいい
}

// 6. dishesテーブル（ごはん：所有権を世帯へ移行）
model Dish {
  id          String   @id @default(cuid())
  householdId String
  createdById String
  name        String
  imageUrl    String?

  // リレーションの定義
  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tags      Tag[]
  showLogs  DishShowLog[]
  requests  MealRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 7. tagsテーブル（キーワード：世帯スコープ化）
model Tag {
  id          String   @id @default(cuid())
  householdId String
  name        String

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dishes    Dish[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, name])
}

// 8. dish_show_logsテーブル（ごはん表示・調停履歴：世帯単位へ移行）
model DishShowLog {
  id          String   @id @default(cuid())
  householdId String
  dishId      String
  decidedById String?
  keyword     String?

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dish        Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
